{
  "name": "nexa-microfinance-bank",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run db:generate && npm run build --workspace=client && npm run build --workspace=server",
    "start": "npx prisma db push --schema=server/prisma/schema.prisma && node server/dist/index.js",
    "postinstall": "npm run db:generate",
    "db:generate": "npm run db:generate --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "db:reset": "npm run db:reset --workspace=server",
    "db:clean": "npm run db:clean --workspace=server"

  },
  "workspaces": ["client", "server"],
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
